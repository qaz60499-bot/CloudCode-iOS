<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Experimental privileged profile only. The stable release is intentionally unsigned so TrollStore can inject its standard fallback identity/keychain entitlements. -->
    <key>application-identifier</key>
    <string>TROLLTROLL.*</string>
    <key>com.apple.developer.team-identifier</key>
    <string>TROLLTROLL</string>
    <key>get-task-allow</key>
    <true/>
    <key>keychain-access-groups</key>
    <array>
        <string>TROLLTROLL.*</string>
        <string>com.apple.token</string>
    </array>
    <key>com.apple.private.security.no-sandbox</key>
    <true/>
    <!-- TrollStore documents that no-sandbox apps may also require platform-application.
         This exact host combination was present in the last device build known to reach
         the UI. AppDataContainers is paired with platform-application so the SwiftUI host
         keeps access to its own data container instead of dying during early startup. -->
    <key>platform-application</key>
    <true/>
    <key>com.apple.private.security.storage.AppDataContainers</key>
    <true/>
    <key>com.apple.private.persona-mgmt</key>
    <true/>
    <!-- Required by the TrollStore-native IOHID GUI backend. The backend still performs
         an isolated runtime handshake and stays unavailable if IOHID cannot be opened. -->
    <key>com.apple.hid.system.server-access</key>
    <true/>
    <key>com.apple.private.hid.client.event-dispatch</key>
    <true/>
</dict>
</plist>

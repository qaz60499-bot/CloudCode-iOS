<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Experimental privileged profile only. The stable release is intentionally unsigned so TrollStore can inject its standard fallback identity/keychain entitlements. -->
    <key>application-identifier</key>
    <string>TROLLTROLL.*</string>
    <key>com.apple.developer.team-identifier</key>
    <string>TROLLTROLL</string>
    <key>get-task-allow</key>
    <true/>
    <key>keychain-access-groups</key>
    <array>
        <string>TROLLTROLL.*</string>
        <string>com.apple.token</string>
    </array>
    <key>com.apple.private.security.no-sandbox</key>
    <true/>
    <!-- TrollStore documents that no-sandbox apps may also require platform-application.
         This exact host combination was present in the last device build known to reach
         the UI. AppDataContainers is paired with platform-application so the SwiftUI host
         keeps access to its own data container instead of dying during early startup. -->
    <key>platform-application</key>
    <true/>
    <key>com.apple.private.security.storage.AppDataContainers</key>
    <true/>
    <key>com.apple.private.persona-mgmt</key>
    <true/>
    <!-- Build 120 fresh device evidence proved the detached AX helper can reach AXRuntime but still
         receives an empty semantic tree while the System-app host is a real RunningBoard client.
         Keep only the AX read entitlement on the host; HID/global-capture privileges remain isolated
         to CloudCodeRootHelper. -->
    <key>com.apple.accessibility.api</key>
    <true/>
    <!-- Build 117/118 device syslog proved that Vision/TextRecognition in the platform host is
         denied before recognition because the platform-app sandbox cannot open the three IOKit
         clients below. Keep this list deliberately narrow: these are the exact clients observed in
         the device denials for local OCR, not the broader GUI/HID entitlement set. -->
    <key>com.apple.security.iokit-user-client-class</key>
    <array>
        <string>AppleJPEGDriverUserClient</string>
        <string>IOSurfaceRootUserClient</string>
        <string>AGXDeviceUserClient</string>
    </array>
    <!-- platform-application tightens IOKit sandbox policy on TrollStore devices. Keep the
         exception-extension form in lockstep with the direct entitlement above so iOS 16.6 can
         authorize exactly the same three Vision/decode clients under either policy path. -->
    <key>com.apple.security.exception.iokit-user-client-class</key>
    <array>
        <string>AppleJPEGDriverUserClient</string>
        <string>IOSurfaceRootUserClient</string>
        <string>AGXDeviceUserClient</string>
    </array>
    <!-- HID / global-capture entitlements intentionally remain on the embedded crash-isolated root
         helper. AX semantic reads are the one exception: Build 120 proved the anonymous helper
         identity itself is the failing boundary, so the host now carries only accessibility.api. -->
</dict>
</plist>
